# Banco de dados
DATABASE_URL=postgres://simulador:simulador@localhost:5432/simulador_educacional
TEST_DATABASE_URL=postgres://simulador:simulador@localhost:5432/simulador_educacional_test

# ActionCable (obrigatório em produção)
REDIS_URL=redis://localhost:6379/0

# Sessões (mesmos nomes do servidor Node legado)
SESSION_DAYS=7
SESSION_COOKIE_NAME=simulador.sid
BOOTSTRAP_TOKEN=
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false
RATE_LIMIT_PERIOD_SECONDS=300
AUTH_RATE_LIMIT_LOGIN_LIMIT=10
AUTH_RATE_LIMIT_REGISTER_LIMIT=5
AUTH_RATE_LIMIT_BOOTSTRAP_LIMIT=5
IMAGEGEN_RATE_LIMIT_GENERATE_LIMIT=20

# Dados persistentes (discos virtuais por usuário, compartilhado com o Node)
PERSISTENT_DATA_DIR=./data

# Biblioteca de apostilas em PDF
BOOKLET_LIBRARY_DIR=../shared/booklets

# Árvore de arquivos base (C:\, D:\, etc.)
BASE_TREE_PATH=../shared/base-tree/dir.json

# Geração de imagens (somente servidor)
IMAGEGEN_API_TOKEN=
IMAGEGEN_API_URL=
IMAGEGEN_PROVIDER=

# CORS para o frontend em desenvolvimento; em produção, deixe vazio quando
# frontend e API forem servidos no mesmo domínio pelo proxy.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
